// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model for NextAuth authentication
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Skill type enum
enum SkillType {
  TECHNOLOGIES
  FRONTEND
  STYLING
  BACKEND
  TESTING
  DEVOPS
  METHODOLOGIES
  AI
}

// Skill model for individual skills
model Skill {
  id                String              @id @default(cuid())
  name              String
  description       String
  type              SkillType
  order             Int
  experienceSkills  ExperienceSkill[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([type, name])
}

// Experience model for work experience
model Experience {
  id        String             @id @default(cuid())
  role      String
  company   String
  location  String
  summary   String?              @db.Text
  description String?            @db.Text
  fromDate  DateTime
  toDate    DateTime?
  order     Int
  // Engagement type shown beside the company, e.g. "Contract". Null for permanent roles.
  type      String?
  // Key into the company logo map in app/lib/companyLogos.ts. Null falls back to initials.
  logo      String?
  // Technologies as listed on the CV; drives the role tags and skill usage counts.
  technologies String[]          @default([])
  skills    ExperienceSkill[]
  featuredWork FeaturedWork[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// Junction table for Experience and Skill many-to-many relationship
model ExperienceSkill {
  id            String      @id @default(cuid())
  experienceId  String
  skillId       String
  order         Int
  experience    Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([experienceId, skillId])
}


// Independent and private client work shown separately from employment
model Project {
  id           String    @id @default(cuid())
  name         String
  role         String
  fromDate     DateTime?
  toDate       DateTime?
  summary      String    @db.Text
  technologies String[]  @default([])
  url          String?
  order        Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A headline result linked to the role that produced it
model FeaturedWork {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  metric       String
  label        String
  title        String
  description  String     @db.Text
  technologies String
  order        Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Education {
  id            String   @id @default(cuid())
  institution   String
  qualification String
  fromYear      Int
  toYear        Int
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Skills grouped as on the CV (the Skill model above is the older, per-skill catalogue)
model SkillGroup {
  id        String   @id @default(cuid())
  name      String
  items     String[]
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single-row site profile. The fixed id keeps it a singleton.
model Profile {
  id                         String   @id @default("profile")
  name                       String
  companyName                String
  jobTitle                   String
  introduction               String   @db.Text
  about                      String[]
  email                      String
  githubUrl                  String
  linkedinUrl                String
  heroSkills                 String[]
  featuredSkills             String[]
  highlightMetric            String
  highlightLabel             String
  currentProjectTitle        String
  currentProjectTechnologies String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}
