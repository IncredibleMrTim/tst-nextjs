# Sanity project (public identifiers, safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Secrets: set these in the host's environment settings, never commit them.
# Shared secret that signs the Sanity publish webhook (see docs/sanity.md)
SANITY_REVALIDATE_SECRET=
# Viewer token (manage.sanity.io > API > Tokens) so preview mode can read drafts
SANITY_API_READ_TOKEN=
# Only needed by `yarn sanity:seed` when writing to the dataset directly
SANITY_API_WRITE_TOKEN=
